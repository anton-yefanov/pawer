+/**
+ * BottomSheetBehavior cooperates with the first descendant that reports nested
+ * scrolling, and on a sheet that hosts any Compose interop view - a menu, a
+ * picker - that is the interop host in the header rather than the list filling
+ * the sheet. Touches outside the resolved child count as drags, so every
+ * gesture over the content moves the sheet and nothing scrolls. Resolve a
+ * descendant that can actually scroll instead, and none at all when nothing can:
+ * a sheet whose content fits has no scrolling to protect, so every gesture over
+ * it should drag the sheet.
+ */
+private class SheetBehavior<V : View> : BottomSheetBehavior<V>() {
+    /**
+     * A footer is pinned over the sheet's visible bottom edge, so a press on it is
+     * never a drag. The behavior does not know that: below the expanded detent it
+     * can move in both directions, so its ViewDragHelper claims a touch that
+     * started on the footer and the press is cancelled before it fires. Turning
+     * dragging off for the duration of such a gesture is what BottomSheetBehavior
+     * already does for a touch that lands on its scrolling child.
+     */
+    override fun onInterceptTouchEvent(
+        parent: CoordinatorLayout,
+        child: V,
+        event: MotionEvent,
+    ): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> isDraggable = !isTouchInFooter(child, event)
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> isDraggable = true
+        }
+        return super.onInterceptTouchEvent(parent, child, event)
+    }
+
+    private fun isTouchInFooter(
+        child: V,
+        event: MotionEvent,
+    ): Boolean {
+        val footer = (child as? Screen)?.footer ?: return false
+        if (footer.visibility != View.VISIBLE || footer.height == 0) {
+            return false
+        }
+        val y = event.y - child.top
+        return y >= footer.top && y < footer.bottom
+    }
+
+    override fun onLayoutChild(
+        parent: CoordinatorLayout,
+        child: V,
+        layoutDirection: Int,
+    ): Boolean {
+        val handled = super.onLayoutChild(parent, child, layoutDirection)
+        val scrollable = findScrollable(child)
+        runCatching {
+            BottomSheetBehavior::class.java
+                .getDeclaredField("nestedScrollingChildRef")
+                .apply { isAccessible = true }
+                .set(this, scrollable?.let { WeakReference(it) })
+        }
+        return handled
+    }
+
+    private fun findScrollable(view: View): View? {
+        if (view.visibility != View.VISIBLE) {
+            return null
+        }
+        if (view.canScrollVertically(-1) || view.canScrollVertically(1)) {
+            return view
+        }
