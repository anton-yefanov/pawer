{
  "expo": {
    "name": "pawer",
    "slug": "pawer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/pawer.icon",
      "bundleIdentifier": "com.antonyefanov.pawer",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow pawer to connect to the development server on your local network.",
        "NSBonjourServices": [
          "_expo-development-server._tcp",
          "_expo-development-server._udp",
          "_exp._tcp",
          "_exp._udp"
        ]
      }
    },
    "android": {
      "package": "com.antonyefanov.pawer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Nunito_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Nunito_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Nunito_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Nunito_700Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "./plugins/with-no-aps-environment",
      "./plugins/with-exact-alarms",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#208AEF"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.antonyefanov.pawer",
          "enablePushNotifications": false,
          "widgets": []
        }
      ]
    ],
    "extra": {
      "revenueCat": {
        "ios": "test_YagBgAzFucASRGNovnWGGEfCpdW",
        "android": "test_YagBgAzFucASRGNovnWGGEfCpdW"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
